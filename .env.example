# ============================================================
# AI Codebase Doctor - environment configuration
# Copy to .env and adjust. All values are safe defaults.
# Never commit real keys. Never log these values.
# ============================================================

# ---- General ----
ENVIRONMENT=development                 # development | production
LOG_LEVEL=INFO                          # structlog level
SECRET_KEY=change-me-generate-a-random-string

# ---- Backend (api/) ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- Frontend (web/) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codedoc
POSTGRES_PASSWORD=codedoc
POSTGRES_DB=codedoc
DATABASE_URL=postgresql+asyncpg://codedoc:codedoc@postgres:5432/codedoc
DATABASE_URL_SYNC=postgresql://codedoc:codedoc@postgres:5432/codedoc

# ---- Qdrant (vector store) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ---- Valkey (cache/queue) ----
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_URL=redis://valkey:6379/0

# ---- MinIO (S3-compatible object store) ----
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=codedoc
MINIO_ROOT_PASSWORD=codedoc-minio
MINIO_BUCKET=codedoc-artifacts

# ---- Error tracking: DSN points AT GLITCHTIP, never Sentry cloud ----
SENTRY_DSN=http://glitchtip:8080/1
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- LLM provider: OpenRouter primary, one key routes to many models ----
# Get a key: https://openrouter.ai/keys  (free-tier models are available)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Role-routed models used by the agents:
OPENROUTER_MODEL_CODING=anthropic/claude-sonnet-4        # Patch Agent
OPENROUTER_MODEL_REASONING=deepseek/deepseek-r1          # Debug Agent
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini                 # Summary Agent

# ---- Optional local LLM fallback (FULL profile only) ----
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Alternative providers (optional; used in fallback chain) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---- Embeddings ----
EMBEDDING_PROVIDER=local                # local | huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_INFERENCE_URL=

# ---- Search ----
SEARCH_PROVIDER=searxng                 # searxng | tavily | brave | serper
SEARXNG_URL=http://searxng:8080
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ---- GitHub ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---- Analysis limits (public demo safety) ----
DEMO_MAX_REPO_MB=256
DEMO_MAX_FILES=5000
DEMO_MAX_SCAN_FILES=200
DEMO_MAX_CONCURRENT_PER_USER=1
DEMO_ANALYSIS_TIMEOUT_MIN=10

# ---- LLM token-safety guards (POST /api/analyze) ----
DEMO_ANALYZE_LIMIT_PER_MIN=20
DEMO_ANALYZE_MAX_CHARS=100000
DEMO_ANALYZE_MAX_TOKENS=512

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus